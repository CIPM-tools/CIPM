import org.palladiosimulator.pcm.repository.RepositoryPackage

import "http://www.emftext.org/java" as java
import "http://palladiosimulator.org/PalladioComponentModel/5.2" as pcm

reactions: commonComponent
in reaction to changes in pcm
execute actions in java

import common

routine moveComponentToRepository(pcm::RepositoryComponent cmp) {
	match {
		val pcmRepository = retrieve pcm::Repository corresponding to RepositoryPackage.Literals.REPOSITORY
	}
	update {
		if (!pcmRepository.components__Repository.contains(cmp)) {
			pcmRepository.components__Repository += cmp
		}
	}
}

routine removeComponentFromRepository(pcm::RepositoryComponent cmp) {
	match {
		val correspondingJRs = retrieve many java::JavaRoot corresponding to cmp
	}
	update {
		for (c : correspondingJRs) {
			removeJavaRoot(c)
		}
	}
}