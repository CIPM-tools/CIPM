// Only possible to implement via AssemblyContext, due to PCM limitations
reaction AddedBasicComponentToCompositeComponent {
	after element pcm::AssemblyContext inserted in pcm::CompositeComponent[assemblyContexts__ComposedStructure]
	with newValue.encapsulatedComponent__AssemblyContext instanceof BasicComponent
	call {
		// TODO Ask for Java correspondents (Module, Package, Classifier), if not already done
