import java.util.List
import tools.vitruv.change.interaction.UserInteractionFactory

import "http://www.emftext.org/java" as java
import "http://palladiosimulator.org/PalladioComponentModel/5.2" as pcm

reactions: basicComponent
in reaction to changes in pcm
execute actions in java

import commonComponent

/**
 * Assumptions:
 * 
 * About name (entityName):
 * 
 * - BasicComponent's name =/= name or namespaces of corresponding Java elements
 * - BasicComponents' Java correspondents are JavaRoot instances (different types possible: ex 1 Package, 1 Module)
 * ---- In general, atomic correspondents is Classifier
 * ---- Here, atomic correspondent is CompilationUnit
 * - BasicComponents' name is NOT affected by potential CompositeComponents' name
 * - BasicComponents' name is INDEPENDENT of the names of its parent components
 * 
 * About correspondences:
 * 
 * - A Classifier can be assigned to a maximum of one component
 * - If a CompilationUnit corresponds to a component, ALL its contents correspond to it. This is NOT the case for other JavaRoot types
 */
reaction AddedBasicComponentToRepository {
	after element pcm::BasicComponent inserted in pcm::Repository[components__Repository]
	call {
		// TODO Ask if corresponding Java elements should be created
		addBasicComponentToRepository(newValue)
	}
}

reaction RemovedBasicComponentFromRepository {
	after element pcm::BasicComponent removed from pcm::Repository[components__Repository]
	call {
		// TODO Ask if corresponding Java elements should exist
		removeComponentFromRepository(oldValue);
	}
}

reaction RenamedBasicComponent {
	after attribute replaced at pcm::BasicComponent[entityName]
	call {
		// TODO Re-implement
	}
}

routine createCorrespondingPackageForBasicComponent(pcm::BasicComponent cmp) {
	match {
		require absence of java::Package corresponding to cmp
	}
	create {
		val pkg = new java::Package
	}
	update {
		updateNamespaceOfJavaCorrespondent(null, pkg)
		updateNameOfJavaCorrespondent(null, pkg)

		addCorrespondenceBetween(cmp, pkg)
	}
}

routine createCorrespondingModuleForBasicComponent(pcm::BasicComponent cmp) {
	match {
		require absence of java::Module corresponding to cmp
	}
	create {
		val mod = new java::Module
	}
	update {
		updateNamespaceOfJavaCorrespondent(null, mod)
		updateNameOfJavaCorrespondent(null, mod)

		addCorrespondenceBetween(cmp, mod)
	}
}

routine addBasicComponentToRepository(pcm::BasicComponent cmp) {
	update {
		// type = 1: Component corresponds to a package
		// type = 2: Component corresponds to a module
		val type = UserInteractionFactory.instance.createDialogUserInteractor().getSingleSelectionDialogBuilder().
			message("New component added to the system. What kind of a JavaRoot is its Java correspondent?").choices(
				List.^of("Package", "Module", "Compilation Unit")).startInteraction()

		if (type == 1) {
			createCorrespondingPackageForBasicComponent(cmp)
		} else if (type == 2) {
			createCorrespondingModuleForBasicComponent(cmp)
		} else if (type == 3) {
			createCorrespondingCUForBasicComponent(cmp)
		}
	}
}

routine createCorrespondingCUForBasicComponent(pcm::BasicComponent cmp) {
	create {
		val cu = new java::CompilationUnit
	}
	update {

		updateNamespaceOfJavaCorrespondent(null, cu)
		updateNameOfJavaCorrespondent(null, cu)

		val type = UserInteractionFactory.instance.createDialogUserInteractor().getSingleSelectionDialogBuilder().
			message("What classifier should the compilation unit declare?").choices(
				List.^of("Class", "Interface", "Leave empty")).startInteraction()

		if (type == 1) {
			createCorrespondingClassForBasicComponent(cmp)
		} else if (type == 2) {
			createCorrespondingInterfaceForBasicComponent(cmp)
		} else {
		}

		addCorrespondenceBetween(cu, cmp)
	}
}

routine createCorrespondingClassForBasicComponent(pcm::BasicComponent cmp) {
	create {
		val cls = new java::Class
	}
	update {
		updateNameOfJavaCorrespondent(null, cls)
		addCorrespondenceBetween(cmp, cls)
	}
}

routine createCorrespondingInterfaceForBasicComponent(pcm::BasicComponent cmp) {
	create {
		val ifc = new java::Interface
	}
	update {
		updateNameOfJavaCorrespondent(null, ifc)
		addCorrespondenceBetween(cmp, ifc)
	}
}
