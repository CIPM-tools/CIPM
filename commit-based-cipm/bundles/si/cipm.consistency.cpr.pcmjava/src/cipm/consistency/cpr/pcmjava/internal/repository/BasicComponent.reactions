import java.util.List
import tools.vitruv.change.interaction.UserInteractionFactory

import "http://www.emftext.org/java" as java
import "http://palladiosimulator.org/PalladioComponentModel/5.2" as pcm

reactions: basicComponent
in reaction to changes in pcm
execute actions in java

import commonComponent

/**
 * Assumptions:
 * 
 * About name (entityName):
 * 
 * - BasicComponent's name = Namespaces of JavaRoot (DO NOT ASSUME THIS)
 * - BasicComponents' Java correspondents have Packages or Modules (can mix both (in general yes))
 * - BasicComponents' name is affected by CompositeComponents' name (NOT THE CASE IN GENERAL)
 * - BasicComponents' name contains all of the names of its parent (NOT THE CASE IN GENERAL)
 * 
 * About correspondences:
 * 
 * - A JavaRoot can be assigned to a maximum of one BasicComponent (parent CompositeComponent then has an implicit correspondence)
 * 
 * To clarify:
 * 
 * TODO: Account for a basic component potentially consisting of multiple packages/modules
 * TODO: Consider user interaction window for populating BasicComponent instances with JavaRoot instances
 */
reaction AddedBasicComponentToRepository {
	after element pcm::BasicComponent inserted in pcm::Repository[components__Repository]
	call {
		addBasicComponentToRepository(newValue)
	}
}

reaction RemovedBasicComponentFromRepository {
	after element pcm::BasicComponent removed from pcm::Repository[components__Repository]
	call {
		removeComponentFromRepository(oldValue);
	}
}

reaction RenamedBasicComponent {
	after attribute replaced at pcm::BasicComponent[entityName]
	call {
		if (!oldValue.equals(newValue))
			setCorrespondingJavaRootNamespacesForBasicComponent(affectedEObject)
	}
}

routine createCorrespondingPackageForBasicComponent(pcm::BasicComponent cmp) {
	match {
		require absence of java::Package corresponding to cmp
	}
	create {
		val pkg = new java::Package
	}
	update {
		updateNamespaceOfCorrespondentJavaRoot(cmp, pkg);
		addCorrespondenceBetween(cmp, pkg)
	}
}

routine createCorrespondingModuleForBasicComponent(pcm::BasicComponent cmp) {
	match {
		require absence of java::Module corresponding to cmp
	}
	create {
		val mod = new java::Module
	}
	update {
		mod.name = cmp.entityName
		addCorrespondenceBetween(cmp, mod)
	}
}

routine setCorrespondingJavaRootNamespacesForBasicComponent(pcm::BasicComponent cmp) {
	match {
		val correspondingJRs = retrieve many java::JavaRoot corresponding to cmp
	}
	update {
		for (c : correspondingJRs) {
			updateNamespaceOfCorrespondentJavaRoot(cmp, c);
		}
	}
}

routine addBasicComponentToRepository(pcm::BasicComponent cmp) {
	update {
		// type = 1: Component corresponds to a package
		// type = 2: Component corresponds to a module
		val type = UserInteractionFactory.instance.createDialogUserInteractor().getSingleSelectionDialogBuilder().
			message("New component added to the system. What kind of a JavaRoot is its Java correspondent?").choices(
				List.^of("Package", "Module")).startInteraction();
		if (type == 1) {
			createCorrespondingPackageForBasicComponent(cmp)
		} else if (type == 2) {
			createCorrespondingModuleForBasicComponent(cmp)
		}
	}
}

routine renameBasicComponent(pcm::BasicComponent cmp) {
	update {
		setCorrespondingJavaRootNamespacesForBasicComponent(cmp)
	}
}

routine updateNamespaceOfCorrespondentJavaRoot(pcm::BasicComponent cmp, java::NamespaceAwareElement nae) {
	update {
		val nss = cmp.entityName.split("\\.");
		nae.namespaces.clear
		nae.namespaces.^addAll(nss);
	}
}