import "http://www.emftext.org/java" as java
import "http://palladiosimulator.org/PalladioComponentModel/5.2" as pcm

reactions: interfaceRequiringEntity
in reaction to changes in pcm
execute actions in java

reaction AddedRequiredRole {
	after element pcm::OperationRequiredRole inserted in pcm::InterfaceRequiringEntity[requiredRoles_InterfaceRequiringEntity]
	call {
		addRequiredRoleToRequiringEntity(affectedEObject, newValue)
	}
}

reaction RemovedRequiredRole {
	after element pcm::OperationRequiredRole removed from pcm::InterfaceRequiringEntity[requiredRoles_InterfaceRequiringEntity]
	call {
		removeRequiredRoleFromRequiringEntity(oldValue)
	}
}

routine addRequiredRoleToRequiringEntity(pcm::InterfaceRequiringEntity entity, pcm::OperationRequiredRole role) {
	match {
		val javaCorrespondents = retrieve many java::ConcreteClassifier corresponding to entity
		val requiredJavaIfc = retrieve java::Interface corresponding to role.requiredInterface__OperationRequiredRole
	}
	update {
		// TODO Add import(s) to requiredJavaIfc in chosen javaCorrespondents (by user)
		// TODO Developer task to integrate the interface in code
	}
}

routine removeRequiredRoleFromRequiringEntity(pcm::OperationRequiredRole role) {
	match {
		val requiringJavaPositions = retrieve many java::TypeReference corresponding to role
		val requiredJavaIfc = retrieve java::Interface corresponding to role.requiredInterface__OperationRequiredRole
	}
	update {
		// TODO Remove redundant imports to requiredJavaIfc
		// TODO Developer task to de-integrate the interface in code
	}
}