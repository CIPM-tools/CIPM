import org.emftext.language.java.containers.JavaRoot
import cipm.consistency.cpr.pcmjava.PCMElementUtil

import "http://www.emftext.org/java" as java
import "http://palladiosimulator.org/PalladioComponentModel/5.2" as pcm

reactions: interfaceRequiringEntity
in reaction to changes in pcm
execute actions in java

reaction AddedRequiredRole {
	after element pcm::OperationRequiredRole inserted in pcm::InterfaceRequiringEntity[requiredRoles_InterfaceRequiringEntity]
	call {
		checkForRequiredDependencies(newValue)
	}
}

reaction RemovedRequiredRole {
	after element pcm::OperationRequiredRole removed from pcm::InterfaceRequiringEntity[requiredRoles_InterfaceRequiringEntity]
	call {
		// TODO implement
	}
}

reaction ChangedRequiredRole {
	after element pcm::OperationRequiredRole replaced at pcm::InterfaceRequiringEntity[requiredRoles_InterfaceRequiringEntity]
	call {
		// TODO implement
	}
}

routine checkForRequiredDependencies(pcm::OperationRequiredRole role) {
	update {
		val requiringEntity = role.requiringEntity_RequiredRole
		val requiredIfc = role.requiredInterface__OperationRequiredRole

		val correspondents = requiringEntity.getCorrespondingElements(JavaRoot, null, null)

		if (!PCMElementUtil.isRequiredRoleNecessary(role, correspondents)) {
			addMissingDependencyToRequiringEntity(requiringEntity, requiredIfc)
		}
	}
}

routine addMissingDependencyToRequiringEntity(pcm::InterfaceRequiringEntity entity, pcm::OperationInterface requiringInterface) {
	update {
		// TODO Add import(s) to required interfaces
		// Ask where to add import(s) (in terms of CompilationUnits / NamespaceClassifierReferences (?))
	}
}