import cipm.consistency.cpr.pcmjava.JavaModelAccess
import org.emftext.language.java.members.MembersFactory
import org.emftext.language.java.types.TypesFactory
import cipm.consistency.cpr.pcmjava.PcmJavaTypeUtil
import cipm.consistency.cpr.pcmjava.PcmJavaCPRUtils
import org.emftext.language.java.classifiers.ClassifiersFactory
import cipm.consistency.cpr.pcmjava.userinteraction.JavaCorrespondentDecisionUserInteraction
import cipm.consistency.cpr.pcmjava.userinteraction.PcmUserInteractionManager
import cipm.consistency.cpr.pcmjava.userinteraction.NamespaceUserInteraction
import org.eclipse.emf.ecore.EObject
import java.util.ArrayList
import org.palladiosimulator.pcm.core.entity.NamedElement
import org.emftext.language.java.modifiers.ModifiersFactory

import "http://www.emftext.org/java" as java
import "http://palladiosimulator.org/PalladioComponentModel/5.2" as pcm

reactions: repositoryDataTypesExistential
in reaction to changes in pcm
execute actions in java

// Only account for CompositeDataTypes' creation and deletion. PrimitiveDataTypes are strictly for primitives in Java sense,
// which cannot be added by the user. CollectionDataTypes are only used for concretely types Array and List occurrences,
// so their creation/deletion is also not eligible for propagation to Java.
//
// All inner DataTypes and InnerDeclarations are, however, still relevant.
//
reaction AddedCompositeDataType {
	after element pcm::CompositeDataType inserted in pcm::Repository[dataTypes__Repository]
	call {
		findOrCreateOrDecideJavaClassifierForDataType(newValue)
	}
}

reaction RemovedCompositeDataType {
	after element pcm::CompositeDataType removed from pcm::Repository[dataTypes__Repository]
	call {
		removeJavaClassifierCorrespondenceForDataType(oldValue)
	}
}

reaction AddedInnerDeclaration {
	after element pcm::InnerDeclaration inserted in pcm::CompositeDataType[innerDeclaration_CompositeDataType]
	call {
		createOrLocateCorrespondingFieldForInnerDeclaration(newValue, newValue.datatype_InnerDeclaration,
			affectedEObject)
	}
}

reaction RemovedInnerDeclaration {
	after element pcm::InnerDeclaration removed from pcm::CompositeDataType[innerDeclaration_CompositeDataType]
	call {
		removeCorrespondingFieldForInnerDeclaration(oldValue, oldValue.datatype_InnerDeclaration)
	}
}

reaction ReplacedInnerDeclarationDataType {
	after element pcm::DataType replaced at pcm::InnerDeclaration[datatype_InnerDeclaration]
	call {
		replaceCorrespondingFieldTypeForInnerDeclarationType(affectedEObject, newValue)
	}
}

// TODO For replacing field types, check if its references can be automatically changed without breaking the code
// Return types, Parameter types, Generic types, method call chains that target the field
//
routine replaceCorrespondingFieldTypeForInnerDeclarationType(pcm::InnerDeclaration pcmInnerDecl, pcm::DataType pcmInnerDeclType) {
	match {
		val field = retrieve java::Field corresponding to pcmInnerDecl
		val newJavaType = retrieve java::ConcreteClassifier corresponding to pcmInnerDeclType
	}
	update {
		// TODO Add developer task to replace Java Field's type
	}
}

routine removeCorrespondingFieldForInnerDeclaration(pcm::InnerDeclaration pcmInnerDecl, pcm::DataType pcmOuterType) {
	match {
		val field = retrieve java::Field corresponding to pcmInnerDecl
		val outerCls = retrieve java::ConcreteClassifier corresponding to pcmOuterType
	}
	update {
		// TODO User interaction for whether the field should be removed, as it is not always
		// possible to determine automatically (ex: if the field is referenced somewhere)
		//
		outerCls.members -= field
		removeCorrespondenceBetween(field, pcmInnerDecl)
	}
}

routine createOrLocateCorrespondingFieldForInnerDeclaration(pcm::InnerDeclaration pcmInnerDecl, pcm::DataType pcmInnerType, pcm::DataType pcmOuterType) {
	match {
		val outerCls = retrieve java::ConcreteClassifier corresponding to pcmOuterType
		val innerCls = retrieve java::ConcreteClassifier corresponding to pcmInnerType
	}
	update {
		var newTypeRef = TypesFactory.eINSTANCE.createClassifierReference()
		newTypeRef.target = innerCls

		// TODO User interaction for whether the field should be replaced, as it is not always
		// possible to determine automatically (ex: if the field is referenced somewhere)
		//
		// Maybe there exists a Java field without correspondence
		var preexistingField = PcmJavaTypeUtil.getJavaFieldForIn(pcmInnerDecl.datatype_InnerDeclaration, outerCls)
		if (preexistingField !== null) {
			// Pre-existing matching field is found => Set its type reference
			preexistingField.typeReference = newTypeRef
			return
		}

		// TODO User interaction for whether a field should be created, as it is not always
		// possible to handle so easily (ex: with element nodes)
		var field = MembersFactory.eINSTANCE.createField()
		field.annotationsAndModifiers += ModifiersFactory.eINSTANCE.createPrivate
		field.name = pcmInnerDecl.entityName
		field.typeReference = newTypeRef

		outerCls.members += field
		addCorrespondenceBetween(field, pcmInnerDecl)
	}
}

routine removeJavaClassifierCorrespondenceForDataType(pcm::CompositeDataType type) {
	match {
		val cls = retrieve java::ConcreteClassifier corresponding to type
	}
	update {

		// TODO User interaction for optionally removing cls
		//
		// Check for dependencies and ask the user what to do:
		// 1) Leave Java counterpart
		// 2) Delete (user-defined) Java counterpart
		type.innerDeclaration_CompositeDataType.forall[removeJavaFieldCorrespondencesForInnerDeclaration]
		removeCorrespondenceBetween(type, cls)
	}
}

routine removeJavaFieldCorrespondencesForInnerDeclaration(pcm::InnerDeclaration pcmInnerDecl) {
	match {
		val field = retrieve java::Field corresponding to pcmInnerDecl
	}
	update {
		// TODO User interaction for optionally removing field
		//
		// Check for dependencies and ask the user what to do:
		// 1) Leave Java counterpart
		// 2) Delete (user-defined) Java counterpart
		removeCorrespondenceBetween(field, pcmInnerDecl)
	}
}

routine findOrCreateOrDecideJavaClassifierForDataType(pcm::CompositeDataType pcmDataType) {
	// Concept:
	// 1) Check if a corresponding classifier exists. Add correspondence if it does
	// 2) Add correspondences between DataType and all references to it (so that they can be adapted accordingly)
	// Corresponding classifier either has a correspondence to a component or to a DataType (limitation)
	match {
		require absence of java::ConcreteClassifier corresponding to pcmDataType
	}
	update {
		// Only match based on names, as it is assumed that PCM DataTypes and their
		// corresponding classifiers have to have the same name.
		//
		// However, there could still be multiple matches since differences in namespaces are possible.
		// In such cases, user has to be asked
		//
		// Not able to narrow down the potential Java correspondents based on concrete type (Class/Interface/Enum),
		// because OperationSignature return types cannot be PCM Interfaces, only PCM DataTypes
		var matchingClassifiers = JavaModelAccess.findPotentialConcreteClassifiers(
			PcmJavaTypeUtil.getDataTypeName(pcmDataType)).filter [
			PcmJavaTypeUtil.doTypesMatch(pcmDataType, it)
		].toList

		if (matchingClassifiers.isEmpty) {

			// TODO User interaction to choose the type of the Java ConcreteClassifier:
			//
			// PCM DataTypes are used for return types too, therefore Java Interfaces / Enums
			// may also require a corresponding DataType
			var cls = ClassifiersFactory.eINSTANCE.createClass
			cls.name = (pcmDataType as NamedElement).entityName

			var namespacesUI = new NamespaceUserInteraction(pcmDataType, cls)
			namespacesUI.allowNoNamespace = true
			PcmUserInteractionManager.addUserInteraction(namespacesUI)
			namespacesUI.resolveAll

			if (namespacesUI.namespaces !== null) {
				cls.annotationsAndModifiers += ModifiersFactory.eINSTANCE.createPublic
				PcmJavaCPRUtils.prepareJavaClassifier(cls)

				PcmJavaCPRUtils.integrateJavaClassifierCorrespondent(correspondenceModel, pcmDataType, cls,
					namespacesUI.namespaces)

				addCorrespondenceBetween(pcmDataType, cls, "")
			}
		} else if (matchingClassifiers.size == 1) {
			addCorrespondenceBetween(pcmDataType, matchingClassifiers.get(0), "")
		} else {
			var clsList = new ArrayList<EObject>(matchingClassifiers)
			val ui = new JavaCorrespondentDecisionUserInteraction(pcmDataType, clsList, "")
			PcmUserInteractionManager.addUserInteraction(ui)
			ui.resolveAll

			addCorrespondenceBetween(pcmDataType, ui.javaCorrespondent, "")
		}
	}
}