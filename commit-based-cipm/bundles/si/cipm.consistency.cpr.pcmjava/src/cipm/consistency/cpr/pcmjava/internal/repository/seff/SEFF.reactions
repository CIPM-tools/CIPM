import "http://www.emftext.org/java" as java
import "http://palladiosimulator.org/PalladioComponentModel/5.2" as pcm

reactions: seff
in reaction to changes in pcm
execute actions in java

import common

reaction AddedDescribedService {
	after element pcm::OperationSignature inserted in pcm::ServiceEffectSpecification[describedService__SEFF]
	call {
		val correspondingJavaMet = newValue.getCorrespondingElement(org.emftext.language.java.members.Method, null,
			null, false)

		if (correspondingJavaMet !== null) {
			checkCorrespondingJavaMethod(affectedEObject, correspondingJavaMet)
		} else {
			createMatchingCorrespondingJavaMethodForSEFF(affectedEObject)
		}
	}
}

