routine addBasicComponentToRepository(pcm::BasicComponent cmp) {
	update {
		// type = 1: Component corresponds to a package
		// type = 2: Component corresponds to a module
		val type = UserInteractionFactory.instance.createDialogUserInteractor().getSingleSelectionDialogBuilder().
			message("New component added to the system. What kind of a JavaRoot is its Java correspondent?").choices(
				List.^of("Package", "Module", "Compilation Unit")).startInteraction()

		if (type == 1) {
			createCorrespondingPackageFor(cmp)
		} else if (type == 2) {
			createCorrespondingModuleFor(cmp)
		} else if (type == 3) {
			createCorrespondingCUFor(cmp)
		}
	}
}

routine removeComponentFromRepository(pcm::RepositoryComponent cmp) {
	match {
		val correspondents = retrieve many java::Commentable corresponding to cmp
	}
	update {
		for (c : correspondents) {
			removeJavaElement(c, cmp)
		}
	}
}