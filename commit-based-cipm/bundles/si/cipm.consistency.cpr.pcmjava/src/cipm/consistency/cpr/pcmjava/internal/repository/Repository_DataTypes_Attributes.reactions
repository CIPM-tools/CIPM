import cipm.consistency.cpr.pcmjava.internal.CprLogUtil

import "http://www.emftext.org/java" as java
import "http://palladiosimulator.org/PalladioComponentModel/5.2" as pcm

reactions: repositoryDataTypesAttributes
in reaction to changes in pcm
execute actions in java

reaction ChangedCompositeDataTypeName {
	after attribute replaced at pcm::CompositeDataType[entityName]
	call {
		CprLogUtil.logCpr(_getCurrentCaller)
		renameClassifierCorrespondingToCompositeDataType(affectedEObject, newValue)
	}
}

reaction ChangedInnerDeclarationName {
	after attribute replaced at pcm::InnerDeclaration[entityName]
	call {
		CprLogUtil.logCpr(_getCurrentCaller)
		renameFieldCorrespondingToInnerDeclaration(affectedEObject, newValue)
	}
}

routine renameClassifierCorrespondingToCompositeDataType(pcm::CompositeDataType e, String newName) {
	match {
		val cls = retrieve java::ConcreteClassifier corresponding to e
	}
	update {
//		if (cls.package.classifiers.exists[it.name.equals(newName)]) {
//			// FIXME Conflict => There is a Classifier under the same package
//			// with "newName", which violates Java language rules
//			//
//			// TODO Deal with the conflict and continue
//		}
		// TODO Check if simply setting the name of the concrete classifier is enough
		cls.name = newName
	}
}

routine renameFieldCorrespondingToInnerDeclaration(pcm::InnerDeclaration innerDecl, String newName) {
	match {
		val field = retrieve java::Field corresponding to innerDecl
	}
	update {
//		if (fieldCls.fields.exists[it.name.equals(newName)]) {
//			// FIXME Conflict => There is a Field in the same concrete classifier
//			// with "newName", which violates Java language rules
//			//
//			// TODO Deal with the conflict and continue
//		}
		// TODO Check if simply setting the name of the field is enough
		field.name = newName
	}
}