import java.util.List
import tools.vitruv.framework.userinteraction.UserInteractionFactory
import org.apache.commons.lang.StringUtils
import com.google.common.collect.Lists
import org.palladiosimulator.pcm.repository.CompositeComponent

import "http://www.emftext.org/java" as java
import "http://palladiosimulator.org/PalladioComponentModel/5.2" as pcm

reactions: compositeComponent
in reaction to changes in PCMExtended
execute actions in AdjustedJava

import basicComponent

/**
  * Assumptions:
  * 
  * About structure:
  * - Further components can be nested in CompositeComponent via their assembly context (under attribute cc.assemblyContexts__ComposedStructure.encapsulatedComponent__AssemblyContext)
  * - If a CompositeComponent CC with nested Components is removed, those components are moved to CC's parents (or to repository, if CC has no parent)
  * 
  * To clarify:
  * 
  * - Can CompositeComponents correspond to JavaRoot instances directly (i.e. without indirections via nested BasicComponents)?
  * 
  * 
  * TODO: Consider user interaction window for populating JavaRoot instances
  */
reaction AddedCompositeComponentToRepository {
	after element pcm::CompositeComponent inserted in pcm::Repository[components__Repository]
	call {
		val newParentName = newValue.entityName
		for (ac:newValue.assemblyContexts__ComposedStructure) {
			updateNamespaceOfNestedComponent("", newParentName, ac.encapsulatedComponent__AssemblyContext)
		}
	}
}

/**
 * TODO: Check whether individual components are used elsewhere
 */
reaction RemovedCompositeComponentInRepository {
	after element pcm::CompositeComponent deleted
	call {
		val choice = UserInteractionFactory.instance.createDialogUserInteractor().getSingleSelectionDialogBuilder().message("A composite component is being removed from the repository. What to do with its nested components?").choices(List.^of("Move them into the repository", "Remove them from the repository too")).startInteraction();
		for (ac:affectedEObject.assemblyContexts__ComposedStructure) {
			val cmp = ac.encapsulatedComponent__AssemblyContext;
			if (choice == 1) {
				moveComponentToRepository(cmp)
			} else if (choice == 2) {
				removeComponentFromRepository(cmp)
			}
		}
	}
}

reaction RenamedCompositeComponent {
	after attribute replaced at pcm::CompositeComponent[entityName]
	call {
		renameNestedComponents(oldValue, newValue, affectedEObject)
	}
}

reaction AddedBasicComponentIntoCompositeComponent {
	after element pcm::AssemblyContext inserted in pcm::CompositeComponent[assemblyContexts__ComposedStructure]
	call {
		val cmp = newValue.encapsulatedComponent__AssemblyContext;
		adaptNamespaceOfNestedComponent(affectedEObject.entityName, cmp)
	}
}

reaction RemovedComponentFromCompositeComponent {
	after element pcm::AssemblyContext removed from pcm::CompositeComponent[assemblyContexts__ComposedStructure]
	call {
		val choices = Lists.newArrayList()
		choices += "Move it into the repository"
		choices += "Remove it from repository"
		val cmp = oldValue.encapsulatedComponent__AssemblyContext
		if (cmp instanceof CompositeComponent) {
			if (!cmp.assemblyContexts__ComposedStructure.isEmpty) {
				choices += "Remove it from the repository, but move its nested components into repository"
			}
		}
		val choice = UserInteractionFactory.instance.createDialogUserInteractor().getSingleSelectionDialogBuilder().message("A component is being removed from a composite component. What to do with it?").choices(choices).startInteraction();
		for (ac:affectedEObject.assemblyContexts__ComposedStructure) {
			if (choice == 1) {
				moveComponentToRepository(cmp)
			} else if (choice == 2) {
				removeComponentFromRepository(cmp)
			} else if (choice == 3) {
				
			}
		}
	}
}

routine renameNestedComponents(String oldParentName, String newParentName, pcm::CompositeComponent parentCmp) {
	action {
		call {
			for (ac:parentCmp.assemblyContexts__ComposedStructure) {
				updateNamespaceOfNestedComponent(oldParentName, newParentName, ac.encapsulatedComponent__AssemblyContext)
			}
		}
	}
}

routine updateNamespaceOfNestedComponent(String oldParentName, String newParentName, pcm::RepositoryComponent nestedCmp) {
	action {
		call {
			val oldName = nestedCmp.entityName
			val oldNamespaces = StringUtils.getCommonPrefix(List.^of(oldName, oldParentName))
			val newName = newParentName + oldName.substring(oldNamespaces.length())
			nestedCmp.entityName = newName
		}
	}
}

routine adaptNamespaceOfNestedComponent(String newParentName, pcm::RepositoryComponent nestedCmp) {
	action {
		call {
			nestedCmp.entityName = newParentName + nestedCmp.entityName
		}
	}
}