import java.util.List
import org.apache.commons.lang.StringUtils
import org.palladiosimulator.pcm.repository.BasicComponent

import "http://www.emftext.org/java" as java
import "http://palladiosimulator.org/PalladioComponentModel/5.2" as pcm

reactions: compositeComponent
in reaction to changes in PCMExtended
execute actions in AdjustedJava

import basicComponent

reaction AddedCompositeComponentToRepository {
	after element pcm::CompositeComponent inserted in pcm::Repository[components__Repository]
	call {
		val newParentName = newValue.entityName
		for (ac:newValue.assemblyContexts__ComposedStructure) {
			updateNamespaceOfNestedComponent("", newParentName, ac.encapsulatedComponent__AssemblyContext)
		}
	}
}

reaction RemovedCompositeComponentInRepository {
	after element pcm::CompositeComponent removed from pcm::Repository[components__Repository]
	call {
		for (ac:oldValue.assemblyContexts__ComposedStructure) {
			val cmp = ac.encapsulatedComponent__AssemblyContext;
			if (cmp instanceof BasicComponent) {
				moveBasicComponentToRepository(cmp)
			}
		}
	}
}

reaction ReplacedCompositeComponentInRepository {
	after element pcm::CompositeComponent replaced at pcm::Repository[components__Repository]
	call {
		val oldParentName = oldValue.entityName
		val newParentName = newValue.entityName
		for (ac:newValue.assemblyContexts__ComposedStructure) {
			updateNamespaceOfNestedComponent(oldParentName, newParentName, ac.encapsulatedComponent__AssemblyContext)
		}
	}
}

routine updateNamespaceOfNestedComponent(String oldParentName, String newParentName, pcm::RepositoryComponent nestedCmp) {
	action {
		call {
			val oldName = nestedCmp.entityName
			val oldNamespaces = StringUtils.getCommonPrefix(List.^of(oldName, oldParentName))
			val newName = newParentName + oldName.substring(oldNamespaces.length())
			nestedCmp.entityName = newName
		}
	}
}