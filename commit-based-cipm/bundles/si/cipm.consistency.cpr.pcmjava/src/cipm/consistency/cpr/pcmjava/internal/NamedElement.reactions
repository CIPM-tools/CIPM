import cipm.consistency.cpr.pcmjava.CorrespondenceTag

import "http://www.emftext.org/java" as java
import "http://palladiosimulator.org/PalladioComponentModel/5.2" as pcm

reactions: namedElement
in reaction to changes in pcm
execute actions in java

import common

reaction RenamedEntity {
	after attribute replaced at pcm::NamedElement[entityName]
	call {
		updateNamesOfCorrespondents(affectedEObject)
		updateNamespacesOfCorrespondents(affectedEObject)
		updateNamesOfCorrespondents(affectedEObject)
	}
}

routine updateNamesOfCorrespondents(pcm::NamedElement ne) {
	match {
		val correspondents = retrieve many java::NamedElement corresponding to ne tagged CorrespondenceTag.
			ONLY_NAME_EQUAL.getTag()
	}
	update {
		for (c : correspondents) {
			setName(ne.entityName, c)
		}
	}
}

routine updateNamespacesOfCorrespondents(pcm::NamedElement ne) {
	match {
		val correspondents = retrieve many java::NamespaceAwareElement corresponding to ne tagged CorrespondenceTag.
			ONLY_NAMESPACE_EQUAL.getTag()
	}
	update {
		for (c : correspondents) {
			setNamespaces(ne.entityName, c)
		}
	}
}

routine updateFullyQualifiedNamesOfCorrespondents(pcm::NamedElement ne) {
	match {
		val correspondents = retrieve many java::NamespaceAwareElement corresponding to ne tagged CorrespondenceTag.
			FULLY_QUALIFIED_NAME_EQUAL.getTag()
	}
	update {
		for (c : correspondents) {
			setFullyQualifiedName(ne.entityName, c)
		}
	}
}