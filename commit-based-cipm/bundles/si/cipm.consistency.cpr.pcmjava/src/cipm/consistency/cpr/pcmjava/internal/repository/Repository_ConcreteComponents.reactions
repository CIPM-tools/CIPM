import tools.vitruv.change.interaction.UserInteractionFactory
import java.util.List

import "http://www.emftext.org/java" as java
import "http://palladiosimulator.org/PalladioComponentModel/5.2" as pcm

reactions: repositoryConcreteComponents
in reaction to changes in pcm
execute actions in java

import basicComponent

// TODO Extract prompts into Java classes, since they are re-usable
reaction AddedBasicComponentToRepository {
	after element pcm::BasicComponent inserted in pcm::Repository[components__Repository]
	call {
		// TODO Ask if corresponding Java elements should be created
		addBasicComponentToRepository(newValue)
	}
}

reaction RemovedBasicComponentFromRepository {
	after element pcm::BasicComponent removed from pcm::Repository[components__Repository]
	call {
		// TODO Ask if corresponding Java elements should be removed
		removeComponentFromRepository(oldValue);
	}
}

reaction AddedCompositeComponentToRepository {
	after element pcm::CompositeComponent inserted in pcm::Repository[components__Repository]
	call {
		// TODO Re-implement
		// Ask whether there should be a direct Java correspondent (i.e. a Java element that directly corresponds to this component)
		// Check dependencies implied by the nested components
	}
}

reaction RemovedCompositeComponentFromRepository {
	after element pcm::CompositeComponent removed from pcm::Repository[components__Repository]
	call {
		// TODO Re-implement
		// Check whether individual components are used elsewhere
		// Ask how/whether the nested components should be distributed or if they should be removed
	}
}

routine addBasicComponentToRepository(pcm::BasicComponent cmp) {
	update {

		// TODO Multiple JavaRoots possible here
		// TODO Extract component creation to a Java class,as it is re-usable
		// type = 1: Component corresponds to a package
		// type = 2: Component corresponds to a module
		val type = UserInteractionFactory.instance.createDialogUserInteractor().getSingleSelectionDialogBuilder().
			message("New component added to the system. What kind of a JavaRoot is its Java correspondent?").choices(
				List.^of("Package", "Module", "Compilation Unit")).startInteraction()

		if (type == 1) {
			createCorrespondingPackageFor(cmp)
		} else if (type == 2) {
			createCorrespondingModuleFor(cmp)
		} else if (type == 3) {
			createCorrespondingCUFor(cmp)
		}
	}
}

routine removeComponentFromRepository(pcm::RepositoryComponent cmp) {
	match {
		val correspondents = retrieve many java::Commentable corresponding to cmp
	}
	update {
		for (c : correspondents) {
			removeJavaElement(c, cmp)
		}
	}
}