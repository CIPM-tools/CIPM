import cipm.consistency.cpr.pcmjava.JavaModelAccess
import cipm.consistency.cpr.pcmjava.PcmJavaCPRUtils
import org.emftext.language.java.types.TypesFactory
import org.eclipse.emf.ecore.util.EcoreUtil
import cipm.consistency.cpr.pcmjava.PCMElementUtil
import org.emftext.language.java.parameters.ParametersFactory

import "http://www.emftext.org/java" as java
import "http://palladiosimulator.org/PalladioComponentModel/5.2" as pcm

reactions: repositoryInterfacesExistential
in reaction to changes in pcm
execute actions in java

reaction AddedInterface {
	after element pcm::OperationInterface inserted in pcm::Repository[interfaces__Repository]
	call {
		findOrCreateOrDecideJavaInterface(newValue)
	}
}

reaction RemovedInterface {
	after element pcm::OperationInterface removed from pcm::Repository[interfaces__Repository]
	call {
		removeJavaInterface(oldValue)
	}
}

routine removeJavaInterface(pcm::OperationInterface pcmIfc) {
	match {
		val javaIfc = retrieve java::Interface corresponding to pcmIfc
	}
	update {
		// TODO Ask if Java correspondent should be removed
		// Check for dependencies and remove if not referenced
		
		javaIfc.eContainer.eContents.remove(javaIfc)
	}
}

reaction AddedParentInterface {
	after element pcm::OperationInterface inserted in pcm::OperationInterface[parentInterfaces__Interface]
	call {
		extendChildInterface(newValue, affectedEObject)
	}
}

routine extendChildInterface(pcm::OperationInterface pcmParentInterface, pcm::OperationInterface pcmChildInterface) {
	match {
		val parentJavaCorrespondent = retrieve java::Interface corresponding to pcmParentInterface
		val childJavaCorrespondent = retrieve java::Interface corresponding to pcmChildInterface
	}
	update {
		var extendsRef = TypesFactory.eINSTANCE.createClassifierReference
		extendsRef.target = parentJavaCorrespondent
		childJavaCorrespondent.extends.add(extendsRef)
	}
}

reaction RemovedParentInterface {
	after element pcm::OperationInterface removed from pcm::OperationInterface[parentInterfaces__Interface]
	call {
		unextendChildInterface(oldValue, affectedEObject)
	}
}

routine unextendChildInterface(pcm::OperationInterface pcmParentInterface, pcm::OperationInterface pcmChildInterface) {
	match {
		val parentJavaCorrespondent = retrieve java::Interface corresponding to pcmParentInterface
		val childJavaCorrespondent = retrieve java::Interface corresponding to pcmChildInterface
	}
	update {
		val parentJavaCorrespondentRef = childJavaCorrespondent.extends.filter [
			EcoreUtil.equals(it.target, parentJavaCorrespondent)
		].toList
		if (parentJavaCorrespondentRef.isEmpty) {
			return
		}

		if (parentJavaCorrespondentRef.size == 1) {
			childJavaCorrespondent.extends.remove(parentJavaCorrespondentRef.get(0))
		} else {
			// TODO User interaction to determine which matching parent interface should be removed
		}
	}
}

reaction AddedOperationSignature {
	after element pcm::OperationSignature inserted in pcm::OperationInterface[signatures__OperationInterface]
	call {
		findOrCreateOrDecideJavaInterfaceMethod(newValue)
	}
}

routine findOrCreateOrDecideJavaInterfaceMethod(pcm::OperationSignature pcmSig) {
	match {
		val javaIfc = retrieve java::Interface corresponding to pcmSig.interface__OperationSignature
	}
	update {
		val potentialMatchingMethods = javaIfc.methods.
			filter[PCMElementUtil.doMethodSignaturesMatch(pcmSig, it, false)].toList

		val correspondent = PcmJavaCPRUtils.findOrCreateOrDecideJavaCorrespondent(pcmSig, potentialMatchingMethods)

		if (correspondent instanceof org.emftext.language.java.members.Method) {
			PcmJavaCPRUtils.
				addCorrespondencesForPcmOperationSignatureAndJavaInterfaceMethod(correspondenceModel, pcmSig,
					correspondent)
		}
	}
}

reaction RemovedOperationSignature {
	after element pcm::OperationSignature removed from pcm::OperationInterface[signatures__OperationInterface]
	call {
		removeJavaInterfaceMethod(oldValue)
	}
}

routine removeJavaInterfaceMethod(pcm::OperationSignature pcmSig) {
	match {
		val javaMet = retrieve java::Method corresponding to pcmSig
	}
	update {
		// TODO Check if removing the Java Method breaks the code
		// TODO User interaction to ask user if Java method should be kept
		javaMet.eContainer.eContents.remove(javaMet)
	}
}

reaction ReplacedOperationSignatureReturnType {
	after element pcm::DataType replaced at pcm::OperationSignature[returnType__OperationSignature]
	call {
		// TODO Change return type in the method in Java interface, if it is unused
		// Only if corresponding Java interface exists
		changeOperationSignatureReturnType(affectedEObject, newValue)
	}
}

routine changeOperationSignatureReturnType(pcm::OperationSignature pcmSig, pcm::DataType newType) {
	match {
		val newTypeJavaCls = retrieve java::ConcreteClassifier corresponding to newType
		val javaMet = retrieve java::Method corresponding to pcmSig
	}
	update {
		// TODO Check if replacing return type breaks code
		// TODO User interaction to resolve issues
		val newTypeRef = TypesFactory.eINSTANCE.createClassifierReference
		newTypeRef.target = newTypeJavaCls
		javaMet.typeReference = newTypeRef
	}
}

reaction AddedExceptionTypeToOperationSignature {
	after element pcm::ExceptionType inserted in pcm::OperationSignature[exceptions__Signature]
	call {
		addExceptionTypeToJavaInterfaceMethod(affectedEObject, newValue)
	}
}

routine addExceptionTypeToJavaInterfaceMethod(pcm::OperationSignature pcmSig, pcm::ExceptionType excType) {
	match {
		val javaMet = retrieve java::Method corresponding to pcmSig
	}
	update {
		var matchingJavaExcs = JavaModelAccess.findPotentialConcreteClassifiers(excType.exceptionName)

		if (matchingJavaExcs.size() == 1) {
			// TODO Check if adding exception type breaks code
			// TODO User interaction to resolve issues
			var excRef = TypesFactory.eINSTANCE.createNamespaceClassifierReference
			excRef.target = matchingJavaExcs.get(0)
			javaMet.exceptions += excRef
		} else if (matchingJavaExcs.size() > 1) {
			// TODO User interaction to ask for which exception is correct
		}
	}
}

reaction RemovedExceptionTypeToOperationSignature {
	after element pcm::ExceptionType removed from pcm::OperationSignature[exceptions__Signature]
	call {
		removeExceptionTypeFromJavaInterfaceMethod(affectedEObject, oldValue)
	}
}

routine removeExceptionTypeFromJavaInterfaceMethod(pcm::OperationSignature pcmSig, pcm::ExceptionType excType) {
	match {
		val javaMet = retrieve java::Method corresponding to pcmSig
	}
	update {
		// TODO Check if removing exception type breaks code
		// TODO User interaction to resolve issues
		javaMet.exceptions.removeIf[it.pureClassifierReference.target.name.equals(excType.exceptionName)]
	}
}

reaction AddedParameterToOperationSignature {
	after element pcm::Parameter inserted in pcm::OperationSignature[parameters__OperationSignature]
	call {
		addParameterToJavaInterfaceMethod(affectedEObject, newValue)
	}
}

routine addParameterToJavaInterfaceMethod(pcm::OperationSignature pcmSig, pcm::Parameter pcmParam) {
	match {
		val javaMet = retrieve java::Method corresponding to pcmSig
		val javaParamCls = retrieve java::ConcreteClassifier corresponding to pcmParam.dataType__Parameter
	}
	update {
		// TODO Check if adding a new parameter to Java method breaks code (most likely)
		val javaParamTypeRef = TypesFactory.eINSTANCE.createClassifierReference
		javaParamTypeRef.target = javaParamCls
		val javaParam = ParametersFactory.eINSTANCE.createOrdinaryParameter
		javaParam.name = pcmParam.parameterName
		javaParam.typeReference = javaParamTypeRef

		PcmJavaCPRUtils.addCorrespondenceToJavaCorrespondent(correspondenceModel, pcmParam, javaParam)
	}
}

reaction RemovedParameterFromOperationSignature {
	after element pcm::Parameter removed from pcm::OperationSignature[parameters__OperationSignature]
	call {
		removeParameterFromJavaInterfaceMethod(affectedEObject, oldValue)
	}
}

routine removeParameterFromJavaInterfaceMethod(pcm::OperationSignature pcmSig, pcm::Parameter pcmParam) {
	match {
		val javaMet = retrieve java::Method corresponding to pcmSig
		val javaParam = retrieve java::Parameter corresponding to pcmParam
	}
	update {
		// TODO Check if removing a parameter from Java method breaks code (most likely)
		javaMet.parameters -= javaParam
	}
}

reaction ReplacedParameterDataType {
	after element pcm::DataType replaced at pcm::Parameter[dataType__Parameter]
	call {
		// TODO Change type in the method in Java interface, if it is unused
		// Only if corresponding Java interface exists
	}
}

routine replaceParameterTypeOfJavaInterfaceMethodParameter(pcm::Parameter pcmParam, pcm::DataType newType) {
	match {
		val newJavaType = retrieve java::ConcreteClassifier corresponding to newType
		val javaParam = retrieve java::Parameter corresponding to pcmParam
	}
	update {
		// TODO Check if replacing a parameter type in Java method breaks code (most likely)
		val javaParamTypeRef = TypesFactory.eINSTANCE.createClassifierReference
		javaParamTypeRef.target = newJavaType
		javaParam.typeReference = javaParamTypeRef
	}
}

routine findOrCreateOrDecideJavaInterface(pcm::OperationInterface pcmIfc) {
	// All PCM interfaces should have one corresponding Java Interface
	// with a matching name. Java namespaces are excluded here
	match {
		require absence of java::Interface corresponding to pcmIfc
	}
	update {
		val matchingJavaIfcs = JavaModelAccess.findPotentialConcreteClassifiers(pcmIfc.entityName)
		var javaCorrespondentOfType = PcmJavaCPRUtils.findOrCreateOrDecideJavaCorrespondent(pcmIfc, matchingJavaIfcs)

		PcmJavaCPRUtils.integrateJavaClassifierCorrespondent(correspondenceModel, pcmIfc, JavaModelAccess.javaModel,
			javaCorrespondentOfType)
	}
}