import cipm.consistency.cpr.pcmjava.internal.CprLogUtil

import "http://www.emftext.org/java" as java
import "http://palladiosimulator.org/PalladioComponentModel/5.2" as pcm

reactions: repositoryInterfacesAttributes
in reaction to changes in pcm
execute actions in java

reaction RenamedInterface {
	after attribute replaced at pcm::OperationInterface[entityName]
	call {
		CprLogUtil.logCpr(_getCurrentCaller)
		renameJavaInterface(affectedEObject, newValue)
	}
}

routine renameJavaInterface(pcm::OperationInterface pcmIfc, String newName) {
	match {
		val javaIfc = retrieve java::Interface corresponding to pcmIfc
	}
	update {
		// TODO Check for conflicts
		javaIfc.name = newName
	}
}

reaction RenamedOperationSignature {
	after attribute replaced at pcm::OperationSignature[entityName]
	call {
		CprLogUtil.logCpr(_getCurrentCaller)
		renameJavaInterfaceMethod(affectedEObject, newValue)
	}
}

routine renameJavaInterfaceMethod(pcm::OperationSignature pcmSig, String newName) {
	match {
		val javaMet = retrieve java::Method corresponding to pcmSig
	}
	update {
		// TODO Check for conflicts
		javaMet.name = newName
	}
}

reaction ReplacedOperationSignatureReturnType {
	after element pcm::DataType replaced at pcm::OperationSignature[returnType__OperationSignature]
	call {
		CprLogUtil.logCpr(_getCurrentCaller)
	// FIXME Set return type in Java
	// TODO Add developer task to adapt operation signature return type
	}
}

reaction RenamedParameter {
	after attribute replaced at pcm::Parameter[parameterName]
	call {
		CprLogUtil.logCpr(_getCurrentCaller)
		renameJavaInterfaceMethodParameter(affectedEObject, newValue)
	}
}

routine renameJavaInterfaceMethodParameter(pcm::Parameter pcmParam, String newName) {
	match {
		val javaParam = retrieve java::Parameter corresponding to pcmParam
	}
	update {
		// TODO Check for conflicts
		javaParam.name = newName
	}
}

reaction ReplacedParameterDataType {
	after element pcm::DataType replaced at pcm::Parameter[dataType__Parameter]
	call {
		CprLogUtil.logCpr(_getCurrentCaller)
	// FIXME Set parameter type in Java
	// TODO Add developer task to adapt parameter type in Java method
	}
}