import com.google.common.collect.Lists
import org.apache.log4j.Logger

import "http://www.emftext.org/java" as java
import "http://palladiosimulator.org/PalladioComponentModel/5.2" as pcm

reactions: seffExistential
in reaction to changes in pcm
execute actions in java

reaction ReplacedSEFFDescribedService {
	after element pcm::OperationSignature replaced at pcm::ServiceEffectSpecification[describedService__SEFF]
	call {
		Logger.getLogger("cipm.consistency.cpr.pcmjava").info(_getCurrentCaller.class.simpleName)
		adjustCorrespondenceBetweenComponentAndSEFFJavaClass(affectedEObject, oldValue, newValue)
	}
}

routine adjustCorrespondenceBetweenComponentAndSEFFJavaClass(pcm::ServiceEffectSpecification seff, pcm::OperationSignature oldPcmSig, pcm::OperationSignature newPcmSig) {
	update {
		if (oldPcmSig !== null) {
			removeCorrespondenceBetweenComponentAndSEFFJavaClass(seff, oldPcmSig)
		}
		addCorrespondenceBetweenComponentAndSEFFJavaClass(seff, newPcmSig)
	}
}

routine addCorrespondenceBetweenComponentAndSEFFJavaClass(pcm::ServiceEffectSpecification seff, pcm::OperationSignature pcmSig) {
	match {
		val javaMet = retrieve java::Method corresponding to pcmSig
	}
	update {
		if (seff.basicComponent_ServiceEffectSpecification !== null) {
			var javaCls = javaMet.containingConcreteClassifier
			addCorrespondenceBetween(seff.basicComponent_ServiceEffectSpecification, javaCls)

			// If there are inner classes, they too should correspond to the same component
			for (innerCls : javaCls.allInnerClassifiers) {
				addCorrespondenceBetween(seff.basicComponent_ServiceEffectSpecification, innerCls)
			}

			var allClss = Lists.newArrayList
			allClss.add(javaCls)
			allClss.addAll(javaCls.allInnerClassifiers)

			if (javaCls.containingConcreteClassifier !== null &&
				allClss.containsAll(javaCls.containingConcreteClassifier.allInnerClassifiers)) {
				addCorrespondenceBetween(seff.basicComponent_ServiceEffectSpecification,
					javaCls.containingConcreteClassifier)
			}

			if (javaCls.containingCompilationUnit !== null &&
				allClss.containsAll(javaCls.containingCompilationUnit.classifiers)) {
				addCorrespondenceBetween(seff.basicComponent_ServiceEffectSpecification,
					javaCls.containingCompilationUnit)
			}

			if (javaCls.package !== null) {
				if (allClss.containsAll(javaCls.package.classifiers)) {
					addCorrespondenceBetween(seff.basicComponent_ServiceEffectSpecification, javaCls.package)
				}

				if (javaCls.package.module !== null &&
					allClss.containsAll(javaCls.package.module.classifiersInSamePackage)) {
					addCorrespondenceBetween(seff.basicComponent_ServiceEffectSpecification, javaCls.package.module)
				}
			}
		}
	}
}

routine removeCorrespondenceBetweenComponentAndSEFFJavaClass(pcm::ServiceEffectSpecification seff, pcm::OperationSignature pcmSig) {
	match {
		val javaMet = retrieve java::Method corresponding to pcmSig
	}
	update {
		if (seff.basicComponent_ServiceEffectSpecification !== null) {
			var javaCls = javaMet.containingConcreteClassifier
			removeCorrespondenceBetween(seff.basicComponent_ServiceEffectSpecification, javaCls)

			for (innerCls : javaCls.allInnerClassifiers) {
				removeCorrespondenceBetween(seff.basicComponent_ServiceEffectSpecification, innerCls)
			}

			if (javaCls.containingConcreteClassifier !== null) {
				removeCorrespondenceBetween(seff.basicComponent_ServiceEffectSpecification,
					javaCls.containingConcreteClassifier)
			}

			if (javaCls.containingCompilationUnit !== null) {
				removeCorrespondenceBetween(seff.basicComponent_ServiceEffectSpecification,
					javaCls.containingCompilationUnit)
			}
			if (javaCls.package !== null) {
				removeCorrespondenceBetween(seff.basicComponent_ServiceEffectSpecification, javaCls.package)
				if (javaCls.package.module !== null) {
					removeCorrespondenceBetween(seff.basicComponent_ServiceEffectSpecification, javaCls.package.module)
				}
			}
		}
	}
}