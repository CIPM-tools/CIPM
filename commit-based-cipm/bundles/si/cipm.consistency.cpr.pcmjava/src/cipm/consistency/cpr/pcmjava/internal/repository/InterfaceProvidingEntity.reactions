import org.emftext.language.java.containers.JavaRoot
import cipm.consistency.cpr.pcmjava.PCMElementUtil

import "http://www.emftext.org/java" as java
import "http://palladiosimulator.org/PalladioComponentModel/5.2" as pcm

reactions: providingEntity
in reaction to changes in pcm
execute actions in java

reaction AddedProvidedRole {
	after element pcm::OperationProvidedRole inserted in pcm::InterfaceProvidingEntity[providedRoles_InterfaceProvidingEntity]
	call {
		checkForProvidedDependencies(newValue)
	}
}

reaction RemovedProvidedRole {
	after element pcm::OperationProvidedRole removed from pcm::InterfaceProvidingEntity[providedRoles_InterfaceProvidingEntity]
	call {
		// TODO implement
	}
}

reaction ChangedProvidedRole {
	after element pcm::OperationProvidedRole replaced at pcm::InterfaceProvidingEntity[providedRoles_InterfaceProvidingEntity]
	call {
		// TODO implement
	}
}

routine checkForProvidedDependencies(pcm::OperationProvidedRole role) {
	update {
		val entity = role.providingEntity_ProvidedRole
		val providedIfc = role.providedInterface__OperationProvidedRole

		val correspondents = entity.getCorrespondingElements(JavaRoot, null, null)

		// Look for any missing dependencies
		val missingDependencies = PCMElementUtil.getPCMMethodsWithoutJavaCorrespondences(
			providedIfc.signatures__OperationInterface, PCMElementUtil.getAllPublicMethodsInJavaRoots(correspondents),
			true)

		for (md : missingDependencies) {
			addMissingDependencyToProvidingEntity(entity, md)
		}
	}
}

routine addMissingDependencyToProvidingEntity(pcm::InterfaceProvidingEntity entity, pcm::OperationSignature missingMetSign) {
	update {
		// TODO Add the missing Java method stub
		// Ask whether a new classifier is necessary for the stub
		// Ask where to put the stub (in terms of classifiers)
	}
}