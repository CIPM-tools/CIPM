		// TODO Developer task to properly implement the interface in code
	}
}

routine removeProvidingRoleFromProvidingEntity(pcm::OperationProvidedRole role) {
	match {
		val requiringJavaPositions = retrieve many java::TypeReference corresponding to role
		val requiredJavaIfc = retrieve java::Interface corresponding to role.providedInterface__OperationProvidedRole
	}
