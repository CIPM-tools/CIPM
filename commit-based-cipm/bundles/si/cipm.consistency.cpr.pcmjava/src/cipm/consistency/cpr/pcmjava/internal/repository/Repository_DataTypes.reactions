import cipm.consistency.cpr.pcmjava.PCMElementUtil
import org.emftext.language.java.classifiers.ConcreteClassifier

import "http://www.emftext.org/java" as java
import "http://palladiosimulator.org/PalladioComponentModel/5.2" as pcm

reactions: repositoryDataTypes
in reaction to changes in pcm
execute actions in java

reaction AddedDataType {
	after element pcm::DataType inserted in pcm::Repository[dataTypes__Repository]
	call {

		// Concept:
		// 1) Check if a corresponding classifier exists. Add correspondence if it does
		// 2) Add correspondences between DataType and all references to it (so that they can be adapted accordingly)
		// TODO Clarify if corresponding classifier could have a correspondence to a component
		val classifiers = PCMElementUtil.getAllJavaCorrespondentsOfType(affectedEObject, correspondenceModel,
			ConcreteClassifier, [
				PCMElementUtil.doTypesMatch(newValue, it)
			])

		if (classifiers.size == 0) {
			createOrLocateJavaClassifierForDataType(newValue)
		} else if (classifiers.size == 1) {
			addCorrespondenceBetween(newValue, classifiers.get(0))
		} else {
			// Detecting multiple potential matches
			// TODO Ask the user which classifier the DataType corresponds to
		}
	}
}

reaction RemovedDataType {
	after element pcm::DataType removed from pcm::Repository[dataTypes__Repository]
	call {
		PCMElementUtil.getAllJavaCorrespondentsOfType(affectedEObject,	correspondenceModel,
			ConcreteClassifier,	[PCMElementUtil.doTypesMatch(oldValue, it)]
		).forEach [
			removeDataTypeCorrespondents(oldValue, it)
		]
		
		// TODO Deal with all dependencies to the removed DataType (ex: References)
	}
}

