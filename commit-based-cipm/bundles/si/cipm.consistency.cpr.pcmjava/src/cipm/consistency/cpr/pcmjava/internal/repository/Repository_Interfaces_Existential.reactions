routine findOrCreateJavaInterfaceMethod(pcm::OperationSignature pcmSig) {
	match {
		val javaIfc = retrieve java::Interface corresponding to pcmSig.interface__OperationSignature
	}
	update {
		val potentialMatchingMethods = javaIfc.methods.filter [
			it.name.equals(pcmSig.entityName)
		].toList

		if (potentialMatchingMethods.size > 1) {
			var corUI = new JavaCorrespondentDecisionUserInteraction(pcmSig, potentialMatchingMethods, "")
			PcmUserInteractionManager.addUserInteraction(corUI)
			corUI.resolveAll

			val matchingJavaMethod = corUI.javaCorrespondent
			if (matchingJavaMethod !== null) {
				// Matching Java method found, add correspondences and return
				PcmJavaCPRUtils.
					addCorrespondencesForPcmOperationSignatureAndJavaInterfaceMethod(correspondenceModel, pcmSig,
						matchingJavaMethod as org.emftext.language.java.members.Method)
				return
			}
		} else if (potentialMatchingMethods.size == 1) {
			PcmJavaCPRUtils.
				addCorrespondencesForPcmOperationSignatureAndJavaInterfaceMethod(correspondenceModel, pcmSig,
					potentialMatchingMethods.get(0))
			return
		}

		val javaInterfaceMethod = MembersFactory.eINSTANCE.createInterfaceMethod
		javaInterfaceMethod.annotationsAndModifiers += ModifiersFactory.eINSTANCE.createPublic
		javaInterfaceMethod.name = pcmSig.entityName
		javaIfc.members += javaInterfaceMethod
	}
}

