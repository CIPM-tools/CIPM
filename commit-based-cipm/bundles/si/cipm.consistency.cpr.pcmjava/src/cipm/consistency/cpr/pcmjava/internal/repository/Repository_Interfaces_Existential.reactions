import cipm.consistency.cpr.pcmjava.JavaModelAccess
import cipm.consistency.cpr.pcmjava.PcmJavaCPRUtils
import org.emftext.language.java.types.TypesFactory
import cipm.consistency.cpr.pcmjava.PCMElementUtil
import org.emftext.language.java.parameters.ParametersFactory
import org.emftext.language.java.members.MembersFactory
import org.emftext.language.java.classifiers.ClassifiersFactory
import cipm.consistency.cpr.pcmjava.userinteraction.PcmUserInteractionManager
import cipm.consistency.cpr.pcmjava.userinteraction.NamespaceUserInteraction
import cipm.consistency.cpr.pcmjava.userinteraction.JavaCorrespondentDecisionUserInteraction
import java.util.ArrayList
import org.eclipse.emf.ecore.EObject
import org.emftext.language.java.classifiers.ConcreteClassifier

import "http://www.emftext.org/java" as java
import "http://palladiosimulator.org/PalladioComponentModel/5.2" as pcm

reactions: repositoryInterfacesExistential
in reaction to changes in pcm
execute actions in java

reaction AddedInterface {
	after element pcm::OperationInterface inserted in pcm::Repository[interfaces__Repository]
	call {
		findOrCreateOrDecideJavaInterface(newValue)
	}
}

routine findOrCreateOrDecideJavaInterface(pcm::OperationInterface pcmIfc) {
	// All PCM interfaces should have one corresponding Java Interface
	// with a matching name. Java namespaces are excluded here
	match {
		require absence of java::Interface corresponding to pcmIfc
	}
	update {
		val matchingJavaIfcs = JavaModelAccess.findPotentialConcreteClassifiers(pcmIfc.entityName)

		// Since CIPM has PCM Interfaces have no namespaces, user disambiguation is necessary in general
		if (matchingJavaIfcs.isEmpty) {
			var cls = ClassifiersFactory.eINSTANCE.createInterface
			cls.name = pcmIfc.entityName

			var namespacesUI = new NamespaceUserInteraction(pcmIfc, cls)
			PcmUserInteractionManager.addUserInteraction(namespacesUI)
			namespacesUI.resolveAll

			PcmJavaCPRUtils.prepareJavaClassifier(cls)

			PcmJavaCPRUtils.integrateJavaClassifierCorrespondent(correspondenceModel, pcmIfc, cls,
				namespacesUI.namespaces)

			addCorrespondenceBetween(pcmIfc, cls, "")

		} else if (matchingJavaIfcs.size == 1) {
			addCorrespondenceBetween(pcmIfc, matchingJavaIfcs.get(0), "")
		// TODO Adapt tag
		} else {
			var ifcList = new ArrayList<EObject>(matchingJavaIfcs)
			val ui = new JavaCorrespondentDecisionUserInteraction(pcmIfc, ifcList, "")
			PcmUserInteractionManager.addUserInteraction(ui)
			ui.resolveAll

			addCorrespondenceBetween(pcmIfc, ui.javaCorrespondent, "")
		// TODO Adapt tag
		}
	}
}

reaction RemovedInterface {
	after element pcm::OperationInterface removed from pcm::Repository[interfaces__Repository]
	call {
		removeJavaInterface(oldValue)
	}
}

routine removeJavaInterface(pcm::OperationInterface pcmIfc) {
	match {
		val javaIfc = retrieve java::Interface corresponding to pcmIfc
	}
	update {
		// TODO Ask if Java correspondent should be removed
		// Check for dependencies and remove if not referenced
		// FIXME Synchronise with paper
		javaIfc.eContainer.eContents.remove(javaIfc)
	}
}

reaction AddedOperationSignature {
	after element pcm::OperationSignature inserted in pcm::OperationInterface[signatures__OperationInterface]
	call {
		findOrCreateJavaInterfaceMethod(newValue)
	}
}

routine findOrCreateJavaInterfaceMethod(pcm::OperationSignature pcmSig) {
	match {
		val javaReturnType = retrieve java::ConcreteClassifier corresponding to pcmSig.returnType__OperationSignature
		val javaIfc = retrieve java::Interface corresponding to pcmSig.interface__OperationSignature
	}
	update {
		val potentialMatchingMethods = javaIfc.methods.findFirst [
			PCMElementUtil.doMethodSignaturesMatch(pcmSig, it, false)
		]

		if (potentialMatchingMethods !== null) {
			PcmJavaCPRUtils.
				addCorrespondencesForPcmOperationSignatureAndJavaInterfaceMethod(correspondenceModel, pcmSig,
					potentialMatchingMethods)
		} else {
			val javaInterfaceMethod = MembersFactory.eINSTANCE.createInterfaceMethod
			javaInterfaceMethod.name = pcmSig.entityName

			val returnTref = TypesFactory.eINSTANCE.createClassifierReference
			returnTref.target = javaReturnType
			javaInterfaceMethod.typeReference = returnTref

			for (p : pcmSig.parameters__OperationSignature) {
				val pType = p.dataType__Parameter
				val javaType = getCorrespondingElement(pType, ConcreteClassifier, null, "", true)

				val paramRef = TypesFactory.eINSTANCE.createClassifierReference
				paramRef.target = javaType

				val javaParam = ParametersFactory.eINSTANCE.createOrdinaryParameter
				javaParam.name = p.parameterName
				javaParam.typeReference = paramRef

				javaInterfaceMethod.parameters += javaParam
			}

			javaIfc.members += javaInterfaceMethod

			PcmJavaCPRUtils.generateJavaInterfaceMethodStubsInImplementors(javaIfc)
		}
	}
}

reaction RemovedOperationSignature {
	after element pcm::OperationSignature removed from pcm::OperationInterface[signatures__OperationInterface]
	call {
		removeJavaInterfaceMethod(oldValue)
	}
}

routine removeJavaInterfaceMethod(pcm::OperationSignature pcmSig) {
	match {
		val javaMet = retrieve java::Method corresponding to pcmSig
	}
	update {
		// TODO Check if removing the Java Method breaks the code
		// TODO User interaction to ask user if Java method should be kept
		// FIXME Synchronise with paper
		javaMet.eContainer.eContents.remove(javaMet)
	}
}

reaction AddedParameterToOperationSignature {
	after element pcm::Parameter inserted in pcm::OperationSignature[parameters__OperationSignature]
	call {
		// TODO Add developer task to add parameter to Java method
	}
}

reaction RemovedParameterFromOperationSignature {
	after element pcm::Parameter removed from pcm::OperationSignature[parameters__OperationSignature]
	call {
		// TODO Add developer task to remove parameter from Java method
	}
}