reaction AddedReturnTypeToOperationSignature {
	after element replaced at pcm::OperationSignature[returnType__OperationSignature]
	call {
		CprLogUtil.logCpr(_getCurrentCaller)
		findOrCreateJavaInterfaceMethod(affectedEObject)
	}
}

