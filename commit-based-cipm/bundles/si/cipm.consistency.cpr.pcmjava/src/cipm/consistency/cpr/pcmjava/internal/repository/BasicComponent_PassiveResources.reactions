import "http://www.emftext.org/java" as java
import "http://palladiosimulator.org/PalladioComponentModel/5.2" as pcm

reactions: basicComponentPassiveResources
in reaction to changes in pcm
execute actions in java

/**
 * PCM PassiveResources are used to limit the degree of parallelism while processing requests.
 * Its Java correspondents are therefore constructs that control the amount of concurrency elements
 * (such as threads and processes) that are using something. For example thread pools, semaphores, locks, ...
 * 
 * For its CPRs, have a singleton class provide the supported Java correspondents of PassiveResource, which
 * are then provided to the user in form of prompts, when they are added to a component. While doing so,
 * account for their required construction / configuration parameters as well (such as thread count).
 * 
 * Reasons behind this construction are the broadness of PassiveResource concept and that it is possible
 * to create many custom constructs for this purpose.
 */
reaction AddedPassiveResourceToBasicComponent {
	after element pcm::PassiveResource inserted in pcm::BasicComponent[passiveResource_BasicComponent]
	call {
		// TODO implement
	}
}

reaction RemovedPassiveResourceFromBasicComponent {
	after element pcm::PassiveResource removed from pcm::BasicComponent[passiveResource_BasicComponent]
	call {
		// TODO implement
	}
}

reaction ChangedPassiveResourceInBasicComponent {
	after element pcm::PassiveResource replaced at pcm::BasicComponent[passiveResource_BasicComponent]
	call {
		// TODO implement
	}
}
