reaction AddedPcmAllocation {
	after element pcm::Allocation inserted as root
	call {
		createAllocationCorrespondence(newValue)
	}
}

routine createAllocationCorrespondence(pcm::Allocation allocation) {
	update {
		addCorrespondenceBetween(allocation, AllocationPackage.Literals.ALLOCATION)
	}
}

reaction AddedUsageModel {
	after element pcm::UsageModel inserted as root
	call {
		createUsageModelCorrespondence(newValue)
	}
}

routine createUsageModelCorrespondence(pcm::UsageModel usageModel) {
	update {
		addCorrespondenceBetween(usageModel, UsagemodelPackage.Literals.USAGE_MODEL)
	}
}
