<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>cipm.consistency</groupId>
		<artifactId>bundles</artifactId>
		<version>0.2.0-SNAPSHOT</version>
	</parent>
	<artifactId>fi</artifactId>
	<packaging>pom</packaging>
	<name>Bundles for first Eclipse instance</name>

	 <repositories>
       	  <repository>
             <id>cipm-mvn</id>
             <name>CIPM's Maven Repository</name>
             <url>https://CIPM-tools.github.io/updatesite/mvn</url>
          </repository>
   	 </repositories>

	<dependencyManagement>
	 <dependencies>

	  <dependency>
            	<groupId>cipm.consistency</groupId>
            	<artifactId>org.splevo.commons</artifactId>
            	<version>${project.version}</version>
          </dependency>
	  <dependency>
            	<groupId>cipm.consistency</groupId>
            	<artifactId>org.splevo.diffing</artifactId>
            	<version>${project.version}</version>
          </dependency>
	  <dependency>
            	<groupId>cipm.consistency</groupId>
            	<artifactId>org.splevo.extraction</artifactId>
            	<version>${project.version}</version>
          </dependency>
	  <dependency>
            	<groupId>cipm.consistency</groupId>
            	<artifactId>org.splevo.jamopp.diffing</artifactId>
            	<version>${project.version}</version>
          </dependency>
	  <dependency>
            	<groupId>cipm.consistency</groupId>
            	<artifactId>org.splevo.jamopp.extraction</artifactId>
            	<version>${project.version}</version>
          </dependency>
	  <dependency>
            	<groupId>cipm.consistency</groupId>
            	<artifactId>org.splevo.jamopp.util</artifactId>
            	<version>${project.version}</version>
          </dependency>

	 </dependencies>
	</dependencyManagement>

	<profiles>
        	<profile>
            		<id>first-instance-build</id>
            		<properties>
                		<skipTests>true</skipTests>
                		<maven.javadoc.skip>true</maven.javadoc.skip>
                		<checkstyle.skip>true</checkstyle.skip>

				<maven.compiler.source>11</maven.compiler.source>
        			<maven.compiler.target>11</maven.compiler.target>
        			<maven.compiler.release>11</maven.compiler.release>
            		</properties>
            	</profile>
    	</profiles>


	<modules>
		<module>cipm.consistency.base.shared</module>
		<module>cipm.consistency.commitintegration.diff.util</module>
		<module>cipm.consistency.commitintegration.settings</module>
		<module>cipm.consistency.tools.evaluation.data</module>
		<module>org.splevo.commons</module>
		<module>org.splevo.diffing</module>
		<module>org.splevo.extraction</module>
		<module>org.splevo.jamopp.diffing</module>
		<module>org.splevo.jamopp.extraction</module>
		<module>org.splevo.jamopp.util</module>
	</modules>

</project>