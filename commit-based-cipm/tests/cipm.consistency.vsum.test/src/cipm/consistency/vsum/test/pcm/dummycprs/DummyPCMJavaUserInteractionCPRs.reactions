import cipm.consistency.cpr.pcmjava.JavaModelAccess
import cipm.consistency.vsum.test.pcm.cprunittests.PcmCPRTestConstants
import cipm.consistency.vsum.test.pcm.userinteraction.PcmUserInteractionManager
import cipm.consistency.vsum.test.pcm.userinteraction.NameUserInteraction
import cipm.consistency.vsum.test.pcm.userinteraction.DistributionUserInteraction
import java.util.ArrayList
import org.eclipse.emf.ecore.EObject
import cipm.consistency.vsum.test.pcm.userinteraction.NamespaceUserInteraction

import "http://www.emftext.org/java" as java
import "http://palladiosimulator.org/PalladioComponentModel/5.2" as pcm

reactions: dummyPCMJavaUserInteractionCPRs
in reaction to changes in pcm
execute actions in java

import dummyPCMCPRCommons

reaction AddedUserInteractionTestInterface {
	after element pcm::Interface inserted in pcm::Repository[interfaces__Repository]
	with newValue.entityName == PcmCPRTestConstants.userInteractionTestInterfaceName
	call {
		createUserInteractionTestInterface(newValue)
	}
}

reaction DeletedUserInteractionTestComponent {
	after element pcm::BasicComponent removed from pcm::Repository[components__Repository]
	with oldValue.entityName == PcmCPRTestConstants.componentContentDistributionTestDeletedComponentName
	call {
		removeUserInteractionTestComponent(oldValue, affectedEObject)
	}
}

reaction AddedUserInteractionNamespaceTestModule {
	after element pcm::BasicComponent inserted in pcm::Repository[components__Repository]
	with newValue.entityName == PcmCPRTestConstants.namespaceTestComponentName
	call {
		createUserInteractionNamespaceTestInterface(newValue)
	}
}

routine createUserInteractionTestInterface(pcm::Interface addedInterface) {
	match {
		check addedInterface.entityName == PcmCPRTestConstants.userInteractionTestInterfaceName
	}
	create {
		val javaInterface = new java::Interface
	}
	update {
		var ui = new NameUserInteraction(addedInterface, javaInterface)
		PcmUserInteractionManager.addUserInteraction(ui)
		var javaInterfaceName = PcmUserInteractionManager.getDesiredFeatureValue(addedInterface,
			ui.desiredFeatures.get(0).feature, true) as String
		javaInterface.name = javaInterfaceName
		logMessage("Java interface created: " + javaInterfaceName)
		JavaModelAccess.javaModel.contents.add(javaInterface)
		logMessage("Java interface added to code model: " + JavaModelAccess.javaModel.contents.contains(javaInterface))
		addCorrespondenceBetween(javaInterface, addedInterface)
		logMessage("Correspondence between Java interface and PCM interface established: " +
			correspondenceModel.getCorrespondingEObjects(addedInterface).contains(javaInterface))
	}
}

routine removeUserInteractionTestComponent(pcm::BasicComponent cmp, pcm::Repository repo) {
	match {
		check cmp.entityName == PcmCPRTestConstants.componentContentDistributionTestDeletedComponentName
	}
	update {
		val javaCorrespondents = new ArrayList<EObject>(correspondenceModel.getCorrespondingEObjects(cmp))

		val possibleDistributionTargets = new ArrayList<EObject>(repo.components__Repository)
		possibleDistributionTargets.remove(cmp)

		PcmUserInteractionManager.addUserInteraction(
			new DistributionUserInteraction(cmp, new ArrayList(javaCorrespondents), possibleDistributionTargets)
		)
		for (javaObj : javaCorrespondents) {
			val cor = PcmUserInteractionManager.getDesiredCorrespondence(javaObj, "", true)
			for (pcmObj : cor.getCorrespondentsFor(javaObj)) {
				addCorrespondenceBetween(javaObj, pcmObj, "")
			}
		}
	}
}

routine createUserInteractionNamespaceTestInterface(pcm::BasicComponent cmp) {
	match {
		check cmp.entityName == PcmCPRTestConstants.namespaceTestComponentName
	}
	create {
		val javaMod = new java::Module
	}
	update {
		var nameUI = new NameUserInteraction(cmp, javaMod)
		PcmUserInteractionManager.addUserInteraction(nameUI)
		var javaInterfaceName = PcmUserInteractionManager.getDesiredFeatureValue(cmp,
			nameUI.desiredFeatures.get(0).feature, true) as String
		javaMod.name = javaInterfaceName

		JavaModelAccess.javaModel.contents.add(javaMod)
		addCorrespondenceBetween(javaMod, cmp)
		
		var namespaceUI = new NamespaceUserInteraction(cmp, javaMod)
		PcmUserInteractionManager.addUserInteraction(namespaceUI)
		var javaInterfaceNamespaces = PcmUserInteractionManager.getDesiredFeatureValue(cmp,
			namespaceUI.desiredFeatures.get(0).feature, true) as String

		javaMod.namespaces += javaInterfaceNamespaces
	}
}