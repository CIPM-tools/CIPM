import cipm.consistency.vsum.test.pcm.compchanges.DummyCompositeChangeCPRSwitch
import cipm.consistency.vsum.test.pcm.compchanges.DummyCompositeChangeMarker
import tools.vitruv.change.atomic.EChange
import java.util.List

import "http://www.emftext.org/java" as java
import "http://palladiosimulator.org/PalladioComponentModel/5.2" as pcm

reactions: dummyPCMCompCPRs
in reaction to changes in pcm
execute actions in java

reaction CompositeChangeOccurred {
	after anychange
	with DummyCompositeChangeMarker.isUnhandledCompositeChange(change)
	call {
		delegateToCompositeChangeCPRs(change)
	}
}

reaction AtomicChangeOccurred {
	after anychange
	with DummyCompositeChangeMarker.isAtomicChange(change)
	call {
		specificAtomicChangeCPR(change)
	}
}

routine delegateToCompositeChangeCPRs(EObject change) {
	update {
		DummyCompositeChangeCPRSwitch.handleCompositeChange(change as EChange, _routinesFacade,
			_routinesFacade.class.simpleName)
	}
}

routine specificCompositeChangeHandler(plain List<EChange> as changeList) {
	update {
		System.out.println("Composite change handled");
	}
}

routine specificAtomicChangeCPR(plain EChange as change) {
	update {
		System.out.println("Atomic change handled");
	}
}